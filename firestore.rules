rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to verify manager access
    function isManagerOfVenue(venueId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/venueManagers/$(request.auth.uid)/venues/$(venueId));
    }

    match /users/{userId} {
      // Users can only read and write their own document
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    match /venues/{venueId} {
      // Marketplace discovery: Anyone can read venues and courts
      allow read: if true;
      // Only authorized managers can edit their venues
      allow write: if isManagerOfVenue(venueId);
      
      match /courts/{courtId} {
        allow read: if true;
        allow write: if isManagerOfVenue(venueId);
      }
    }

    match /locks/{lockId} {
      // Anyone can read slot locks to see real-time availability in the matrix
      allow read: if true;
      
      // Locks MUST be acquired via the authoritative acquireSlotLock Cloud Function
      allow write: if false;
    }

    match /bookings/{bookingId} {
      // Players can read their own bookings. Managers can read bookings for their venues.
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        isManagerOfVenue(resource.data.venueId)
      );
      
      // Clients CANNOT create or update bookings directly. 
      // ALL booking state transitions must happen via Cloud Functions.
      allow write: if false; 
    }

    match /venueManagers/{managerId} {
      allow read: if request.auth != null && request.auth.uid == managerId;
      allow write: if false; // Server-side admin provisioning only

      match /venues/{venueId} {
        allow read: if request.auth != null && request.auth.uid == managerId;
        allow write: if false;
      }
    }
  }
}
